# mDEV_backend environment variables
# Copy this file to .env and edit values.

# ---- HTTP ----
PORT=4000
ALLOWED_ORIGIN=http://localhost:5173

# ---- Auth ----
# Required. Must be at least 16 chars. Use a long random string.
# Example:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-please-use-a-real-very-long-random-secret-here-12345
# How long a user session lasts. Default 7d.
JWT_EXPIRES_IN=7d

# ---- Database ----
# In development, you can run a local Mongo.  For tests, the suite uses
# mongodb-memory-server (no external Mongo required).
MONGO_URI=mongodb+srv://bdstream:08980898@cluster0.swssdc9.mongodb.net/mdev_hotspot?appName=Cluster0

# ---- Logging ----
# Optional. One of: debug, info, warn, error. Default: info.
LOG_LEVEL=info

# Optional. development | production | test. Default: development.
NODE_ENV=development

