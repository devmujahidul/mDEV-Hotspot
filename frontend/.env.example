# Frontend env example - copy to .env and edit.
# All frontend env vars MUST be prefixed with VITE_ to be exposed to the client.

# Base URL for the backend API.  When unset we use a relative path
# and rely on the Vite dev server's /api proxy.  In production, set
# this to the absolute origin of the backend, e.g.
#   https://api.example.com
VITE_API_BASE=/api

# When set, used to build the "install command" shown on the router
# detail page (so the command references the public WebSocket URL).
# Example:  wss://api.example.com/ws
VITE_WS_URL=ws://localhost:4000/ws
